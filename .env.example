# Copy to .env and replace values; do not commit a populated .env file.
# These variables can also be exported directly in the shell.

# Inference: non-default locations of the local modules.
CONSERVE_COMPRESSION_DIR=/path/to/ConServe/compression
CONSERVE_HELPER_DIR=/path/to/ConServe/inference
CONSERVE_BASE_INFERENCE=/path/to/ConServe/inference/SFT_M3_optimized.py

# Training: verl checkout pinned at commit 3ba8181 (see README: Training).
VERL_ROOT=/path/to/verl
# M3 SFT (see docs/training.md).
LLAMAFACTORY_ROOT=/path/to/LLaMA-Factory
MODEL_PATH=/path/to/Qwen3.5-9B
SFT_DIR=/path/to/m3_sft_data
SFT_DATA_DIR=/path/to/m3_sft_data/llamafactory_data
SFT_OUTPUT_DIR=/path/to/m3_sft_checkpoint
# Optional: defaults to training/opsd_vl_global_caption.sh in this repository.
# VERL_TRAIN_SCRIPT=/path/to/other_compatible_launcher.sh
STUDENT_MODEL=/path/to/m3_sft_checkpoint
# Optional: defaults to STUDENT_MODEL.
# TEACHER_MODEL=/path/to/other_teacher_checkpoint
TRAIN_PARQUET=/path/to/data/train.parquet
VAL_PARQUET=/path/to/data/val.parquet
# Default GPU allocation: 12 student + 4 teacher GPUs on one node.
NNODES=1
N_GPUS_PER_NODE=16
# Optional: defaults to this repository's compression/ directory.
# TOKEN_COMPRESS_CLUSTER_CODE_DIR=/path/to/ConServe/compression

# OPSD data preparation (training/build_opsd_data.sh).
AGENT_RESULTS_JSONL=/path/to/data/results.jsonl
VLM_OUTPUT_DIR=/path/to/data/vlm_outputs
IMAGE_LIST_JSONL=/path/to/data/image_list.jsonl
OCR_DIR=/path/to/data/ocr
OUTPUT_DIR=/path/to/data/opsd
# Optional: defaults to this repository's inference/ directory.
# CODE_DIR=/path/to/ConServe/inference
# Optional: set both only when generated paths need remapping for training.
# MNT_ROOT=/path/to/data
# NOTEBOOK_ROOT=/path/in/training/environment

# Fixed-OCR Agent batch evaluation (scripts/run_full_test_fixed_ocr_agent_batch.sh).
FULL_TEST_RESULT_ROOT=/path/to/inference/results
FULL_TEST_DATA_ROOT=/path/to/data
FULL_TEST_OUTPUT_ROOT=/path/to/evaluation/output
# TEXT_CRITIC_RUNTIME_CONFIG=/path/to/private/runtime.json

# Agent service credentials are read only from the shell environment.
MODEL_SERVICE_AK=
MODEL_SERVICE_SK=
